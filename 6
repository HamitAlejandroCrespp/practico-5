#include <iostream>
using namespace std;
int main() {
    int n;
    bool valido = true;
    cout << "Ingrese numero: "; cin >> n;
    while (n > 0) {
        if (n % 10 > 7) valido = false;
        n /= 10;
    }
    if(valido) cout << "Es valido" << endl;
    else cout << "Es invalido" << endl;
    return 0;
}
