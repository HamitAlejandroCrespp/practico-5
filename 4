#include <iostream>
using namespace std;
int main() {
    int n, original, invertido = 0;
    cout << "Ingrese numero: "; cin >> n;
    original = n;
    while (n > 0) {
        invertido = (invertido * 10) + (n % 10);
        n /= 10;
    }
    if (original == invertido) cout << "Es capicua" << endl;
    else cout << "No es capicua" << endl;
    return 0;
}
