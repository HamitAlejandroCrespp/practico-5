#include <iostream>
using namespace std;
int main() {
    int n, complemento = 0, multiplicador = 1;
    cout << "Ingrese numero: "; cin >> n;
    while (n > 0) {
        int digito = n % 10;
        int nuevo_digito = 9 - digito;
        complemento = complemento + (nuevo_digito * multiplicador);
        multiplicador *= 10;
        n /= 10;
    }
    cout << "Complemento a 9: " << complemento << endl;
    return 0;
}
